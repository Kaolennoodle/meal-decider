{
  "name": "meal-decider",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite build && wrangler dev",
    "deploy": "vite build && wrangler deploy",
    "db:init:local": "wrangler d1 execute meal-decider-db --local --file=./migrations/0001_init.sql",
    "db:init:remote": "wrangler d1 execute meal-decider-db --remote --file=./migrations/0001_init.sql",
    "cf-typegen": "wrangler types"
  },
  "dependencies": {
    "canvas-confetti": "^1.9.4",
    "lucide-react": "^1.16.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.0.0",
    "@cloudflare/workers-types": "^5.20261104.1",
    "@tailwindcss/vite": "^4.0.14",
    "@types/canvas-confetti": "^1.9.0",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "tailwindcss": "^4.0.14",
    "typescript": "~5.7.3",
    "vite": "^6.2.0",
    "wrangler": "^4.0.0"
  }
}
