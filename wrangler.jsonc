{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "meal-decider",
  "main": "worker/index.ts",
  "compatibility_date": "2025-03-01",
  "assets": {
    "not_found_handling": "single-page-application",
    "binding": "ASSETS"
  },
  "vars": {
    "ADMIN_PIN": "8888"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "meal-decider-db",
      "database_id": "35e4b64e-aa6d-4caa-b107-2b9ea7e76711",
      "migrations_dir": "migrations"
    }
  ],
  "observability": {
    "enabled": true
  }
}
